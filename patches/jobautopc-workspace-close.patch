+ 'use strict';
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('fs');
+const os = require('os');
+const path = require('path');
+const { WorkspaceSync } = require('../ssh_broker/workspace_sync');
+const { TerminalRegistry } = require('../ssh_broker/terminal_registry');
+const alice = { ssoUsername: 'alice', workspaceFolder: 'cdx-alice' };
+const bob = { ssoUsername: 'bob', workspaceFolder: 'cdx-bob' };
+async function fixture(t) {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), 'workspace-close-'));
+  t.after(() => fs.rmSync(root, { recursive: true, force: true }));
+  const sync = new WorkspaceSync(root), registry = new TerminalRegistry(root);
+  const body = { folder: 'cdx-alice', slug: 'project' };
+  fs.mkdirSync(path.join(root, body.folder, body.slug), { recursive: true });
+  fs.writeFileSync(path.join(root, body.folder, body.slug, 'keep.txt'), 'work');
+  for (const [id, identity, slug] of [['one', alice, 'project'], ['other-device', alice, 'project'], ['other-project', alice, 'other'], ['other-user', bob, 'project']]) {
+    await registry.create(identity, { terminal_id: id, folder: identity.workspaceFolder, slug, tool: 'codex' }, async () => ({ created: true }));
+  }
+  const close = (stop) => sync.close(body, (remove) => registry.closeWorkspace(alice, body.slug, stop, remove));
+  return { root, sync, registry, body, close };
+}
+test('close stops all workspace terminals before deleting files, metadata and grants, preserves other scopes, and retries safely', async (t) => {
+  const { root, sync, registry, body, close } = await fixture(t);
+  fs.mkdirSync(sync.meta, { recursive: true });
+  sync.write(body, { session_version: 8 });
+  const ticket = path.join(sync.meta, `ticket-${'a'.repeat(64)}.json`);
+  const result = path.join(sync.meta, `result-${'b'.repeat(64)}.json`);
+  const other = path.join(sync.meta, `ticket-${'c'.repeat(64)}.json`);
+  for (const file of [ticket, result]) fs.writeFileSync(file, JSON.stringify(body));
+  fs.writeFileSync(other, JSON.stringify({ ...body, slug: 'other' }));
+  const stopped = [];
+  await close(async (id) => {
+    assert.ok(fs.existsSync(path.join(root, body.folder, body.slug, 'keep.txt')));
+    stopped.push(id);
+  });
+  assert.deepEqual(stopped, ['one', 'other-device']);
+  for (const file of [path.join(root, body.folder, body.slug), sync.file(body), ticket, result]) assert.equal(fs.existsSync(file), false);
+  assert.ok(fs.existsSync(other));
+  assert.deepEqual((await registry.list(alice, async () => true)).terminals.map((t) => t.terminal_id), ['other-project']);
+  assert.equal((await registry.list(bob, async () => true)).terminals.length, 1);
+  await close(async () => assert.fail('already removed'));
+});
+test('failed terminal stop retains files and inventory for retry', async (t) => {
+  const { root, registry, body, close } = await fixture(t);
+  await assert.rejects(close(async () => { throw new Error('stop failed'); }), /stop failed/);
+  assert.ok(fs.existsSync(path.join(root, body.folder, body.slug, 'keep.txt')));
+  assert.equal((await registry.list(alice, async () => true)).terminals.length, 3);
+  await close(async () => {});
+});
+test('close rejects traversal, symlink directories and active transfers', async (t) => {
+  const { root, sync, body, close } = await fixture(t);
+  await assert.rejects(sync.close({ ...body, slug: '../other' }, () => assert.fail()), /invalid_workspace_close_request/);
+  const outside = path.join(root, 'outside'); fs.mkdirSync(outside);
+  fs.symlinkSync(outside, path.join(root, body.folder, 'linked'));
+  await assert.rejects(sync.close({ ...body, slug: 'linked' }, () => assert.fail()), /workspace_invalid_directory/);
+  await sync.locked(body, async () => {
+    await assert.rejects(close(() => assert.fail()), /workspace_busy/);
+  });
+});
