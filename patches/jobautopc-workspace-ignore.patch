+'use strict';
+const fs = require('fs');
+const os = require('os');
+const path = require('path');
+const { spawn } = require('child_process');
+// Keep identical to antisw/src-tauri/resources/workspace-sync.gitignore.
+const DEFAULT_IGNORES = 'node_modules/\ntarget/\ndist/\nbuild/\n.next/\n.nuxt/\n.output/\n.cache/\n.turbo/\n.parcel-cache/\n.vite/\ncoverage/\n.venv/\nvenv/\n__pycache__/\n.pytest_cache/\n.mypy_cache/\n.gradle/\n.DS_Store\n*.pyc\n*.pyo\n';
+
+async function select(root) {
+  root = await fs.promises.realpath(root);
+  const temp = await fs.promises.mkdtemp(path.join(os.tmpdir(), 'workspace-filter-'));
+  try {
+    await fs.promises.mkdir(path.join(temp, 'objects'));
+    await fs.promises.mkdir(path.join(temp, 'refs'));
+    await fs.promises.writeFile(path.join(temp, 'HEAD'), 'ref: refs/heads/sync\n');
+    await fs.promises.writeFile(path.join(temp, 'defaults'), DEFAULT_IGNORES);
+    async function ignored(names) {
+      if (!names.length) return new Set();
+      return new Promise((resolve, reject) => {
+        const child = spawn('git', ['--git-dir', temp, '--work-tree', root, '-c', `core.excludesFile=${path.join(temp, 'defaults')}`, '-c', 'core.ignoreCase=false', 'check-ignore', '--no-index', '-v', '-z', '--stdin'], { cwd: root, stdio: ['pipe', 'pipe', 'pipe'] });
+        const output = [], errors = [];
+        child.stdout.on('data', (data) => output.push(data));
+        child.stderr.on('data', (data) => errors.push(data));
+        child.on('error', reject);
+        child.stdin.on('error', reject);
+        child.on('close', (code) => {
+          if (code !== 0 && code !== 1) return reject(new Error(`workspace_ignore_failed: ${Buffer.concat(errors)}`));
+          const fields = Buffer.concat(output).toString('utf8').split('\0');
+          const ignored = new Set();
+          for (let i = 0; i + 3 < fields.length; i += 4) {
+            if (!fields[i + 2].startsWith('!')) ignored.add(fields[i + 3]);
+          }
+          resolve(ignored);
+        });
+        child.stdin.end(`${names.join('\0')}\0`);
+      });
+    }
+    const selected = [];
+    let pending = [''];
+    while (pending.length) {
+      const entries = [];
+      for (const relative of pending) {
+        for (const entry of await fs.promises.readdir(path.join(root, relative), { withFileTypes: true })) {
+          if (entry.name === '.git') continue;
+          const name = relative ? `${relative}/${entry.name}` : entry.name;
+          entries.push({ name, entry, query: name });
+        }
+      }
+      pending = [];
+      const excluded = await ignored(entries.map(({ query }) => query));
+      for (const { name, entry, query } of entries) {
+        if (excluded.has(query) && entry.name !== '.gitignore') continue;
+        selected.push(name);
+        if (entry.isDirectory()) pending.push(name);
+      }
+    }
+    return selected;
+  } finally { await fs.promises.rm(temp, { recursive: true, force: true }); }
+}
+module.exports = { select, DEFAULT_IGNORES };
