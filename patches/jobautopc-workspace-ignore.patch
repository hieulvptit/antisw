+'use strict';
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('fs');
+const os = require('os');
+const path = require('path');
+const crypto = require('crypto');
+const { select, DEFAULT_IGNORES } = require('../ssh_broker/workspace_files');
+const { fingerprint, WorkspaceSync } = require('../ssh_broker/workspace_sync');
+const sha = (value) => crypto.createHash('sha256').update(value).digest('hex');
+function fixture(t) {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), 'workspace-ignore-test-'));
+  t.after(() => fs.rmSync(root, { recursive: true, force: true }));
+  const write = (name, data = 'data') => {
+    const full = path.join(root, name); fs.mkdirSync(path.dirname(full), { recursive: true }); fs.writeFileSync(full, data);
+  };
+  return { root, write };
+}
+test('nested gitignore, anchored paths, negations and defaults work without .git', async (t) => {
+  const { root, write } = fixture(t);
+  write('.gitignore', '*.log\n!keep.log\n/root-only.txt\n!build/\nbuild/*\n!build/keep.txt\n');
+  write('src/.gitignore', '*.tmp\n!keep.tmp\n');
+  for (const name of ['node_modules/pkg/file', 'target/debug/file', 'dist/bundle', 'drop.log', 'root-only.txt', 'src/drop.tmp', 'build/drop.txt']) write(name);
+  for (const name of ['README.md', 'keep.log', 'src/root-only.txt', 'src/keep.tmp', 'build/keep.txt']) write(name);
+  const selected = new Set(await select(root));
+  for (const name of ['README.md', 'keep.log', 'src/root-only.txt', 'src/keep.tmp', 'build/keep.txt', '.gitignore', 'src/.gitignore']) assert.ok(selected.has(name), name);
+  for (const name of ['node_modules', 'target', 'dist', 'drop.log', 'root-only.txt', 'src/drop.tmp', 'build/drop.txt']) assert.ok(!selected.has(name), name);
+  const before = await fingerprint(root, true);
+  write('target/debug/file', 'rebuilt');
+  assert.equal(await fingerprint(root, true), before);
+  write('README.md', 'edited');
+  assert.notEqual(await fingerprint(root, true), before);
+});
+test('filtered fingerprint matches client format and keeps legacy clients supported', async (t) => {
+  const { root, write } = fixture(t);
+  write('hello.txt', 'hello'); write('build/large');
+  assert.equal(await fingerprint(root, true), sha(`F aGVsbG8udHh0 ${sha('hello')}\n`));
+  assert.notEqual(await fingerprint(root), await fingerprint(root, true));
+});
+test('workspace check/prepare negotiate filter version and return a receipt after upload', async (t) => {
+  const { root, write } = fixture(t);
+  write('cdx-test/repo/target/large');
+  const manager = new WorkspaceSync(root);
+  let body = { folder: 'cdx-test', slug: 'repo', client_id: 'a', session_id: 's', session_version: 0, sync_revision: 0, baseline_fingerprint: null, fingerprint: sha(''), git: { repository: false, dirty: false, pushed: false, head: null }, sync_filter_version: 1 };
+  assert.equal((await manager.check(body)).status, 'upload_required');
+  const prepared = await manager.prepare({ ...body, direction: 'upload' });
+  assert.equal(prepared.sync_filter_version, 1);
+  await manager.transfer(prepared.ticket, `workspace-sync ${prepared.ticket} --server -a . cdx-test/repo/`, async () => 0);
+  const receipt = manager.result({ ...body, ticket: prepared.ticket });
+  body = { ...body, session_version: receipt.session_version, sync_revision: receipt.sync_revision, baseline_fingerprint: receipt.fingerprint };
+  const checked = await manager.check(body);
+  assert.equal(checked.sync_filter_version, 1);
+  assert.equal(checked.status, 'synced');
+});
