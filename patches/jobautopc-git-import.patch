@@ -0,0 +1,55 @@
+ 'use strict';
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('fs');
+const os = require('os');
+const path = require('path');
+const { GitService } = require('../ssh_broker/git_service');
+const { TerminalRegistry } = require('../ssh_broker/terminal_registry');
+const identity = { ssoUsername: 'alice', workspaceFolder: 'cdx-alice' };
+const body = { repo_url: 'https://git.vnpay.vn/group/Repo.git', tool: 'codex' };
+function fixture(t, credential = { host: 'git.vnpay.vn', pat: 'secret' }) {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), 'git-import-'));
+  t.after(() => fs.rmSync(root, { recursive: true, force: true }));
+  const registry = new TerminalRegistry(root);
+  const service = new GitService(registry, { allowed: ['git.vnpay.vn'], read: async () => credential }, {
+    enabled: () => true,
+    safeDirectory(dir) { fs.mkdirSync(dir, { recursive: true }); return dir; },
+    gitInvocation(folder, slug) { return { target: path.join(root, folder, slug) }; },
+  });
+  return { root, registry, service };
+}
+test('import clones into unique workspace before launching CLI, registers inventory, returns no PAT', async (t) => {
+  const { root, registry, service } = fixture(t);
+  service.run = async (call, input) => {
+    assert.equal(input.operation, 'clone'); assert.equal(input.credential.pat, 'secret');
+    assert.deepEqual(fs.readdirSync(call.target), []);
+    fs.writeFileSync(path.join(call.target, 'README.md'), 'repo');
+  };
+  const launch = async (input) => {
+    assert.equal(fs.readFileSync(path.join(root, input.folder, input.slug, 'README.md'), 'utf8'), 'repo');
+    return { created: true };
+  };
+  const first = await service.importRepository(identity, body, launch);
+  const second = await service.importRepository(identity, body, launch);
+  assert.notEqual(first.slug, second.slug);
+  assert.equal((await registry.list(identity, async () => true)).terminals.length, 2);
+  assert.ok(!JSON.stringify(first).includes('secret'));
+});
+test('clone or terminal launch failure removes the new workspace and leaves no inventory', async (t) => {
+  const { root, registry, service } = fixture(t);
+  service.run = async (call) => { fs.writeFileSync(path.join(call.target, 'partial'), 'data'); throw new Error('git_command_failed'); };
+  await assert.rejects(service.importRepository(identity, body, () => assert.fail()), /git_command_failed/);
+  assert.deepEqual(fs.readdirSync(path.join(root, identity.workspaceFolder)), []);
+  service.run = async () => {};
+  await assert.rejects(service.importRepository(identity, body, async () => { throw new Error('launch_failed'); }), /launch_failed/);
+  assert.deepEqual(fs.readdirSync(path.join(root, identity.workspaceFolder)), []);
+  assert.equal((await registry.list(identity, async () => true)).terminals.length, 0);
+});
+test('missing PAT or disallowed URL blocks import before allocating a workspace', async (t) => {
+  const { root, service } = fixture(t, null);
+  await assert.rejects(service.importRepository(identity, body, () => assert.fail()), /git_credentials_not_found/);
+  await assert.rejects(service.importRepository(identity, { ...body, repo_url: 'https://evil.example/group/repo.git' }, () => assert.fail()), /git_host_not_allowed/);
+  await assert.rejects(service.importRepository(identity, { ...body, repo_url: 'https://alice:secret@git.vnpay.vn/group/repo.git' }, () => assert.fail()), /invalid_git_repo_url/);
+  assert.equal(fs.existsSync(path.join(root, identity.workspaceFolder)), false);
+});
