+'use strict';
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs/promises');
+const os = require('node:os');
+const path = require('node:path');
+const { execFileSync } = require('node:child_process');
+const { validBranch, branchInventory, preparePush, repositoryUrl, pushToRepository, switchBranch } = require('../ssh_broker/git_worker');
+async function fixture(t) {
+  const root = await fs.mkdtemp(path.join(os.tmpdir(), 'git-branches-'));
+  t.after(() => fs.rm(root, { recursive: true, force: true }));
+  const remote = path.join(root, 'remote.git'); const repo = path.join(root, 'repo');
+  execFileSync('git', ['init', '--bare', remote], { stdio: 'ignore' });
+  execFileSync('git', ['init', '-b', 'main', repo], { stdio: 'ignore' });
+  const git = async (args) => execFileSync('git', ['-c', 'core.hooksPath=/dev/null', ...args], { cwd: repo, encoding: 'utf8', stdio: ['ignore', 'pipe', 'pipe'] }).trim();
+  await git(['config', 'user.name', 'Tester']); await git(['config', 'user.email', 'test@example.com']);
+  await fs.writeFile(path.join(repo, 'file.txt'), 'initial\n');
+  await fs.writeFile(path.join(repo, '.gitignore'), 'ignored.txt\n');
+  await git(['add', '.']); await git(['commit', '-m', 'initial']);
+  await git(['remote', 'add', 'origin', remote]); await git(['push', 'origin', 'main']);
+  return { repo, git, remote };
+}
+test('branch validation rejects option injection and invalid refs', () => {
+  for (const value of ['main', 'feature/new', 'release-1.2', 'nhánh']) assert.equal(validBranch(value), true);
+  for (const value of ['', '-main', 'a..b', 'a b', 'a\\b', 'a@{b', 'a.lock', '.hidden', 'a//b', 'a/', 'a?', 'a[', '@', 'x'.repeat(257)]) assert.equal(validBranch(value), false, value);
+});
+test('inventory combines local and remote branches, and supports remote-only clone selection', async (t) => {
+  const { git, remote } = await fixture(t);
+  await git(['branch', 'local-only']); await git(['push', 'origin', 'main:remote-only']);
+  assert.deepEqual(await branchInventory(git, remote), { branches: ['local-only', 'main', 'remote-only'], current_branch: 'main' });
+  assert.deepEqual(await branchInventory(git, remote, true), { branches: ['main', 'remote-only'], current_branch: null });
+});
+test('new branch commits changes and new files, preserves ignored files, and can push', async (t) => {
+  const { repo, git, remote } = await fixture(t);
+  await fs.writeFile(path.join(repo, 'file.txt'), 'updated\n'); await fs.writeFile(path.join(repo, 'new.txt'), 'new\n');
+  await fs.writeFile(path.join(repo, 'ignored.txt'), 'ignored\n');
+  assert.equal(await preparePush({ branch: 'feature/new', create_branch: true, commit_message: 'update files' }, git, remote), 'feature/new');
+  assert.equal(await git(['log', '-1', '--format=%s']), 'update files');
+  assert.equal(await git(['status', '--porcelain']), '');
+  assert.equal(await git(['ls-files', 'ignored.txt']), '');
+  await git(['push', 'origin', 'HEAD:refs/heads/feature/new']);
+  assert.match(await git(['ls-remote', '--heads', remote, 'refs/heads/feature/new']), /refs\/heads\/feature\/new$/);
+  await assert.rejects(preparePush({ branch: 'feature/new', create_branch: true }, git, remote), /git_branch_exists/);
+});
+test('remote-only branch is fetched before committing and an empty workspace adds no commit', async (t) => {
+  const { repo, git, remote } = await fixture(t);
+  await git(['push', 'origin', 'main:remote-only']);
+  const oldHead = await git(['rev-parse', 'HEAD']);
+  await preparePush({ branch: 'remote-only', commit_message: 'no changes' }, git, remote);
+  assert.equal(await git(['branch', '--show-current']), 'remote-only'); assert.equal(await git(['rev-parse', 'HEAD']), oldHead);
+  await fs.writeFile(path.join(repo, 'file.txt'), 'updated\n');
+  await preparePush({ branch: 'main', commit_message: 'on main' }, git, remote);
+  assert.equal(await git(['branch', '--show-current']), 'main'); assert.equal(await git(['log', '-1', '--format=%s']), 'on main');
+});
+test('collisions, missing branches, invalid messages and unsafe checkout fail without committing', async (t) => {
+  const { repo, git, remote } = await fixture(t);
+  await git(['push', 'origin', 'main:remote-only']);
+  await assert.rejects(preparePush({ branch: 'remote-only', create_branch: true }, git, remote), /git_branch_exists/);
+  await assert.rejects(preparePush({ branch: 'missing' }, git, remote), /git_branch_not_found/);
+  await assert.rejects(preparePush({ branch: 'new', create_branch: true, commit_message: ' ' }, git, remote), /invalid_git_commit_message/);
+  await git(['switch', '-c', 'other']); await fs.writeFile(path.join(repo, 'file.txt'), 'other\n');
+  await git(['commit', '-am', 'other']); await git(['switch', 'main']); await fs.writeFile(path.join(repo, 'file.txt'), 'unsaved\n');
+  const head = await git(['rev-parse', 'HEAD']);
+  await assert.rejects(preparePush({ branch: 'other', commit_message: 'should not commit' }, git, remote), /git_checkout_failed/);
+  assert.equal(await git(['rev-parse', 'HEAD']), head); assert.equal(await fs.readFile(path.join(repo, 'file.txt'), 'utf8'), 'unsaved\n');
+});
+test('push-only leaves working changes uncommitted; detached HEAD requires a branch choice', async (t) => {
+  const { repo, git, remote } = await fixture(t);
+  const head = await git(['rev-parse', 'HEAD']); await fs.writeFile(path.join(repo, 'file.txt'), 'unsaved\n');
+  assert.equal(await preparePush({}, git, remote), 'main'); assert.equal(await git(['rev-parse', 'HEAD']), head);
+  await git(['checkout', '--', 'file.txt']); await git(['checkout', '--detach']);
+  await assert.rejects(preparePush({}, git, remote), /invalid_git_branch/);
+  assert.equal(await preparePush({ branch: 'detached-work', create_branch: true }, git, remote), 'detached-work');
+});
