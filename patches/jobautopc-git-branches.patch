+test('standalone branch creation and switching preserve uncommitted files without network or commits', async (t) => {
+  const { repo, git } = await fixture(t);
+  await fs.writeFile(path.join(repo, 'file.txt'), 'work in progress\n');
+  await fs.writeFile(path.join(repo, 'new.txt'), 'new file\n');
+  const head = await git(['rev-parse', 'HEAD']);
+  const localGit = async (args) => {
+    assert.ok(!['push', 'fetch', 'ls-remote', 'commit', 'add'].includes(args[0]), args.join(' '));
+    return git(args);
+  };
+  assert.equal(await switchBranch({ branch: 'feature/work', create_branch: true }, localGit, null), 'feature/work');
+  assert.equal(await git(['branch', '--show-current']), 'feature/work');
+  assert.equal(await git(['rev-parse', 'HEAD']), head);
+  assert.equal(await fs.readFile(path.join(repo, 'file.txt'), 'utf8'), 'work in progress\n');
+  assert.equal(await fs.readFile(path.join(repo, 'new.txt'), 'utf8'), 'new file\n');
+  assert.equal(await switchBranch({ branch: 'main' }, localGit, null), 'main');
+  await assert.rejects(switchBranch({ branch: 'feature/work', create_branch: true }, localGit, null), /git_branch_exists/);
+  await assert.rejects(switchBranch({ branch: 'missing' }, localGit, null), /git_branch_not_found/);
+  await assert.rejects(switchBranch({ branch: '-invalid', create_branch: true }, localGit, null), /invalid_git_branch/);
+});
+test('standalone branch switch rejects conflicting changes without modifying their contents', async (t) => {
+  const { repo, git } = await fixture(t);
